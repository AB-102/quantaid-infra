#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: quantaid-base
    username: anb
    # Console login only; SSH is key-only (allow-pw: false)
    password: "__ANB_PASSWORD_HASH__"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "__ANB_SSH_PUBLIC_KEY__"
  storage:
    layout:
      name: direct
  packages:
    - curl
  late-commands:
    - echo 'anb ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-anb-nopasswd
    - chmod 440 /target/etc/sudoers.d/90-anb-nopasswd
