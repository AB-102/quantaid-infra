#!/bin/sh
# Deploys the newest main commit whose CI run passed. Run by {{ au_service }}-update.timer.
set -e

# Recorded only after a successful deploy, so a failed one is retried next run
DEPLOYED_FILE=/home/anb/.{{ au_service }}-deployed-sha

# Unauthenticated GitHub API: 60 requests/hour per IP
RUNS=$(curl -fsS "https://api.github.com/repos/{{ au_github_repo }}/actions/workflows/ci.yml/runs?branch=main&event=push&status=success&per_page=1")
GREEN_SHA=$(echo "$RUNS" | jq -r '.workflow_runs[0].head_sha')

if [ "$GREEN_SHA" = "null" ]; then
    echo "No passing CI run on main yet"
    exit 1
fi

if [ "$GREEN_SHA" = "$(cat "$DEPLOYED_FILE" 2>/dev/null)" ]; then
    exit 0
fi

echo "Deploying $GREEN_SHA"
cd {{ au_repo_dir }}
git fetch origin main
git reset --hard "$GREEN_SHA"
cd {{ au_build_dir }}
{% for command in au_build_commands %}
{{ command }}
{% endfor %}
sudo systemctl restart {{ au_service }}
echo "$GREEN_SHA" > "$DEPLOYED_FILE"
