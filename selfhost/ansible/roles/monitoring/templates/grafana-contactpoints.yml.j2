apiVersion: 1
contactPoints:
  - orgId: 1
    name: quantaid-alerts
    receivers:
      - uid: quantaid-email
        type: email
        settings:
          addresses: {{ monitoring_alert_email_to }}
      - uid: quantaid-ntfy
        type: webhook
        settings:
          # ntfy's built-in grafana template turns Grafana's JSON into a readable push
          url: https://ntfy.sh/{{ monitoring_ntfy_topic }}?template=grafana
