#!/bin/sh
set -e

BACKUP_DIR=/var/backups/quantaid-mongo
RETENTION_DAYS={{ monitoring_backup_retention_days }}
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
DEST="$BACKUP_DIR/$TIMESTAMP"

mkdir -p "$DEST"
mongodump --config=/opt/quantaid-backup/mongodump-config.yaml --gzip --out="$DEST"

find "$BACKUP_DIR" -maxdepth 1 -type d -mtime +$RETENTION_DAYS -exec rm -rf {} \;

echo "quantaid_backup_last_success_timestamp $(date +%s)" > {{ node_exporter_textfile_dir }}/quantaid_backup.prom.tmp
mv {{ node_exporter_textfile_dir }}/quantaid_backup.prom.tmp {{ node_exporter_textfile_dir }}/quantaid_backup.prom
