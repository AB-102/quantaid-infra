apiVersion: 1
groups:
  - orgId: 1
    name: quantaid-alerts
    folder: Quantaid
    interval: 1m
    rules:
      - uid: backup-stale
        title: MongoDB backup hasn't succeeded recently
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: time() - quantaid_backup_last_success_timestamp
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params: [93600]
        # No metric at all means no backup has succeeded on this host yet, which is a stale backup too.
        # Without this, Grafana fires a generic DatasourceNoData alert instead of this rule.
        noDataState: Alerting
        for: 5m
        annotations:
          summary: "No successful MongoDB backup in over 26 hours"
          description: "Check journalctl -u quantaid-backup on the Docker host (Route B) or the monitoring VM (Route A)."

      - uid: backend-health-unreachable
        title: Backend /health check failing
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: probe_success{job="blackbox_backend_health"}
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
        for: 2m
        annotations:
          summary: "The backend's /health check has failed for 2 minutes"
          description: "Check the backend's logs (docker compose logs backend on Route B, journalctl -u quantaid-backend on Route A), then Atlas."

      - uid: vm-disk-high
        title: VM disk usage above 85%
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: 100 - ((node_filesystem_avail_bytes{mountpoint="/"} * 100) / node_filesystem_size_bytes{mountpoint="/"})
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params: [85]
        for: 10m
        annotations:
          summary: "Disk usage on / is above 85%"
          description: "See what uses it with docker system df and sudo du -sh /var/lib/docker /var/backups/quantaid-mongo."

      - uid: vm-cpu-high
        title: VM CPU usage above 90%
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: 100 - (avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100)
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params: [90]
        for: 10m
        annotations:
          summary: "CPU usage above 90% for 10 minutes"
          description: "Find the busy process with top, or docker stats on Route B."

      - uid: vm-mem-high
        title: VM memory usage above 90%
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: 100 - ((node_memory_MemAvailable_bytes * 100) / node_memory_MemTotal_bytes)
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: gt
                    params: [90]
        for: 10m
        annotations:
          summary: "Memory usage above 90% for 10 minutes"
          description: "Check free -h and docker stats on Route B; the backend's workers use the most."

      - uid: public-health-failing
        title: quantaid.org failing from outside
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: probe_success{job="blackbox_public_health"}
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
        for: 2m
        annotations:
          summary: "https://quantaid.org/api/health has failed from outside for 2 minutes"
          description: "Users may be getting errors. Check which connectors the tunnel's page in the Cloudflare dashboard lists, then docker compose ps and journalctl -u quantaid-gate on each host."

      - uid: database-error
        title: A backend reports database errors
        condition: C
        data:
          - refId: A
            datasourceUid: prometheus
            relativeTimeRange:
              from: 600
              to: 0
            model:
              instant: true
              expr: probe_success{job="blackbox_database"}
          - refId: C
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    type: lt
                    params: [1]
        for: 2m
        annotations:
          summary: "A /health check has said the database isn't connected for 2 minutes"
          description: "The instance label is the URL that failed. The public URL reaches whichever host answered, so check docker compose logs backend on every host, then Atlas. The health gate keeps such a host serving."
