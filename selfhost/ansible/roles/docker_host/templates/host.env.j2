# Written by Ansible (the docker_host role) from the inventory and the vault; edit those, not this file.
# The updater writes .env from this file plus selfhost/release.env on main.

# --- host ---
SERVED_BY={{ inventory_hostname }}
COMPOSE_PROFILES={{ compose_profiles }}
BACKEND_WORKERS={{ backend_workers }}

# --- heartbeats and off-site backups. No quotes: the scripts read these lines as they are. ---
HC_PING_KEY={{ vault_healthchecks_ping_key }}
BACKUP_SAS_URL={{ vault_backup_sas_url }}

# --- backend ---
OPENAI_API_KEY='{{ vault_backend_openai_api_key }}'
MONGODB_URI='{{ vault_backend_mongodb_uri }}'
ADMIN_EMAILS='{{ vault_backend_admin_emails }}'
JWT_SECRET_KEY='{{ vault_backend_jwt_secret_key }}'
RESEND_API_KEY='{{ vault_backend_resend_api_key }}'

# --- monitoring. Every host gets these, so Compose can read the whole file, even without the monitoring profile. ---
MONGODB_BACKUP_URI='{{ vault_monitoring_mongodb_backup_uri }}'
MONGODB_MONITOR_URI='{{ vault_monitoring_mongodb_monitor_uri }}'
NTFY_TOPIC='{{ vault_monitoring_ntfy_topic }}'
SMTP_PASSWORD='{{ vault_monitoring_smtp_password }}'
ALERT_EMAIL_TO='{{ vault_monitoring_alert_email_to }}'

# --- tunnel ---
CLOUDFLARE_TUNNEL_TOKEN='{{ vault_proxy_cloudflare_tunnel_token }}'
