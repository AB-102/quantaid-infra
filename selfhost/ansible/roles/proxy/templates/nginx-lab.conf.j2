upstream backend {
    server {{ groups['backend'][0] }}:8000;
}

upstream frontend {
    server {{ groups['frontend'][0] }}:5173;
}

server {
    # Tunnel requests carry Host: quantaid.org, so they need the default server. Rocky's nginx.conf has its own
    # port-80 server block, on IPv4 and IPv6; without [::]:80 here, cloudflared's localhost connections over ::1
    # would get the nginx welcome page.
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ inventory_hostname }};

    # Inherited by the locations below, which set no headers of their own
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # Which host answered, for tracing a failing request to that host's logs
    add_header X-Served-By $hostname always;

    location / {
        proxy_pass http://frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 10m;  # Image and screenshot uploads; nginx defaults to 1m
    }
}
