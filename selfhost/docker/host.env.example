# Copy to host.env (gitignored), fill in, then chmod 600. Single-quote any value containing $.
# This host's own settings and secrets. The updater (update/update.sh) writes .env from this file plus
# selfhost/release.env on main, so never edit .env itself.

# --- host ---
# Sent as the X-Served-By header, to tell which host answered a request
SERVED_BY=quantaid-laptop

# --- backend ---
OPENAI_API_KEY=your-openai-api-key
MONGODB_URI=your-mongodb-connection-uri
ADMIN_EMAILS=admin1@email.com,admin2@email.com
JWT_SECRET_KEY=your-jwt-secret-key
# Sending-only Resend key for mail.quantaid.org, separate from SMTP_PASSWORD below. Empty turns email off.
RESEND_API_KEY=your-resend-api-key

# --- monitoring ---
# Read-only Atlas user for the mongodump backups
MONGODB_BACKUP_URI=mongodb+srv://backup-user:password@cluster.mongodb.net/quantaid
# Read-only Atlas user for mongodb-exporter
MONGODB_MONITOR_URI=mongodb+srv://monitor-user:password@cluster.mongodb.net/admin
# Hard-to-guess ntfy.sh topic for alerts
NTFY_TOPIC=your-unique-topic-name
# Resend API key, for Grafana's alert email
SMTP_PASSWORD=your-resend-api-key
ALERT_EMAIL_TO=you@example.com

# --- tunnel ---
# Connector token of the Cloudflare Tunnel (shared with the VM route)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-connector-token
