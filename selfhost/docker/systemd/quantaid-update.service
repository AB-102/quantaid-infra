[Unit]
Description=Deploy the Quantaid release pinned in quantaid-infra
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# anb owns the infra clone and /var/lib/quantaid, and is in the docker group
User=anb
WorkingDirectory=/home/anb/quantaid-infra/selfhost/docker
# Through sh: SELinux lets services read files under /home, but not execute them
ExecStart=/bin/sh update/update.sh
TimeoutStartSec=15min
