# The release quantaid.org runs. Every host reads this file from main,
# so merging a change to it is a production deploy, and reverting that change is a rollback.
QUANTAID_VERSION=2026.10.0
# Hosts prepare a new release as soon as they see it, and switch this many minutes after the change reached main,
# so every host has the release's files before any host serves it. 0 only for an urgent rollback.
SWITCH_DELAY_MINUTES=10
